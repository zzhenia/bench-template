# The Bench — settings (not secret, committed). Keys live in keys.env.

# Project-management tool for ticket comments: jira | asana | none.
# Set by setup.sh. Empty or none = no ticket step anywhere.
PM_TOOL=

# Window and session colour: red | blue | green | yellow | purple | orange | pink | cyan.
# Set by setup.sh; switch with scripts/bench-colour.py.
BENCH_COLOR=
