# The Bench — Configuration
# Copy this file to keys.env and fill in your values.
# keys.env is gitignored and never committed.

# ── Your Name ────────────────────────────────────────────────────────────────
# Displayed in the Actions Dashboard header (e.g. "Ben's Actions Dashboard")
BENCH_OWNER=

# ── Jira (only if PM_TOOL=jira in config/bench.env) ─────────────────────────
JIRA_URL=https://your-workspace.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Asana (only if PM_TOOL=asana in config/bench.env) ───────────────────────
ASANA_PAT=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Sheets (optional) ──────────────────────────────────────────────────
GOOGLE_KEY_FILE=
SHEET_ID=
