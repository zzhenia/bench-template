{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "colors=(red blue green yellow purple orange pink cyan); idx=$((RANDOM % 8)); color=${colors[$idx]}; printf '{\"systemMessage\":\"Random color: %s — type /color %s\"}' \"$color\" \"$color\"",
            "timeout": 5,
            "statusMessage": "Picking session color..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/convo_session.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for >> topic..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/prompt_session_note.sh\"",
            "if": "Bash(git push*)",
            "timeout": 15,
            "statusMessage": "Checking session note..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/check_ai_annotations.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for @ai annotations..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-note.sh\"",
            "timeout": 10,
            "statusMessage": "Session note reminder..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/response-length-budget.py\"",
            "timeout": 10,
            "statusMessage": "Checking response length..."
          }
        ]
      }
    ]
  }
}
